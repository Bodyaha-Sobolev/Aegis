// 8-bit and 16-bit integers: i8, u8, i16, u16.
// Same rules as i32/u32: explicit annotation, decimal literals checked
// against the type width, hex bit patterns use the full width, arithmetic
// wraps modulo 2^width, shift counts are taken modulo the width.

struct Pixel { r: u8, g: u8, b: u8 }

fn brightness(p: Pixel) -> u16 {
    return u16(p.r) + u16(p.g) + u16(p.b);
}

fn main() {
    let a: i8 = 127;
    let m: i8 = -128;
    let mask: u8 = 0xff;
    let word: i16 = -32768;

    println("i8 wraps at the byte boundary:");
    printi(a + 1);
    printi(m - 1);

    println("hex bit patterns use the full width:");
    printi(mask);
    printi(word);

    println("channels widened for the sum:");
    let p = Pixel { r: 255, g: 128, b: 1 };
    printi(brightness(p));

    println("shifts count modulo the width:");
    printi(mask << 9);
    printi(mask >> 4);
    printi(word >> 8);
}
